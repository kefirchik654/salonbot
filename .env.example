# Адрес базы PostgreSQL.
# Локально (pgAdmin):  postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/salonbot
# На Railway:          ставится ссылкой на сервис Postgres (см. инструкцию), тут не нужен
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/salonbot

# Публичный https-адрес бота (для карты). Локально оставьте пустым.
# На Railway: https://ваш-домен.up.railway.app
PUBLIC_URL=

# Порт (на Railway поставьте 8080)
PORT=8080

